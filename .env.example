ADMIN_USERNAME=admin
ADMIN_PASSWORD=自行替换复杂的密码

GATEWAY_ADMIN_SECRET=随机密钥
DJANGO_SECRET_KEY=随机密钥
CREDENTIAL_ENCRYPTION_KEY=至少32位随机密钥
ALLOW_REGISTER=true
DJANGO_ALLOWED_HOSTS=你的域名,django,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://你的域名
CLOUDFLARE_TURNSTILE=本地验证码local/Cloudflare验证码enable/关闭disable
CLOUDFLARE_TURNSTILE_SITE_KEY=站点密钥
CLOUDFLARE_TURNSTILE_SECRET_KEY=站点机密

# 商业套餐功能。开发环境可先使用 SQLite；正式环境切换 PostgreSQL。
BILLING_ENABLED=false
BILLING_ENFORCE_SUBSCRIPTION=false
BILLING_MOCK_PAYMENTS=false
REDEMPTION_CODES_ENABLED=false
REDEMPTION_CODE_KEYRING_PATH=/run/secrets/redemption_code_keyring
DJANGO_CACHE_URL=redis://redis:6379/2
PAYMENT_PROVIDER=manual
BILLING_ORDER_HOLD_MINUTES=30
PAYMENT_CALLBACK_LOCK_ENABLED=true
PAYMENT_CALLBACK_MAX_AGE_SECONDS=900
PAYMENT_CALLBACK_MAX_FUTURE_SKEW_SECONDS=300
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536

# Optional Alipay production configuration. Keep PAYMENT_PROVIDER=manual unless
# the dedicated docker-compose.alipay.yml overlay is enabled on the server.
ALIPAY_ENV=production
ALIPAY_SECRET_ROOT=./secrets
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private_key
ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain/0x/billing/alipay/notify
ALIPAY_RETURN_URL=https://your-domain/admin#/account/billing
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_HTTP_TIMEOUT_SECONDS=15
ALIPAY_RECONCILE_BATCH_SIZE=50
EMAIL_VERIFICATION_ENABLED=false
EMAIL_ALLOWED_DOMAINS=qq.com,vip.qq.com,foxmail.com,163.com,126.com,yeah.net,gmail.com,googlemail.com
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD_FILE=/run/secrets/qq_smtp_password
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_RATE_WINDOW_SECONDS=900
EMAIL_VERIFICATION_MAX_SENDS_PER_WINDOW=3
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_DELIVERY_MAX_ATTEMPTS=3
EMAIL_BINDING_TICKET_TTL_SECONDS=900
EMAIL_NOTIFICATIONS_ENABLED=false
DATABASE_ENGINE=sqlite
SQLITE_PATH=/app/backend/db/db.sqlite3
POSTGRES_DB=chatgpt_mirror
POSTGRES_USER=chatgpt_mirror
POSTGRES_PASSWORD=请替换为随机数据库密码
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
